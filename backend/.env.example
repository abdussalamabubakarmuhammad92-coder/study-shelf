# StudyShelf backend environment — copy to .env and fill in.
# NEVER commit the real .env file.

# Required in production (DEBUG=False refuses the default dev key).
SECRET_KEY=django-insecure-dev-only-secret-key-change-me

# Set to False in production.
DEBUG=True

# Comma-separated hosts allowed to serve the site in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Production database (Postgres; SQLite is the default when unset).
# DATABASE_URL=postgres://portal_user:portal_pass@db:5432/resource_portal

# Optional extra CORS origins for separate frontend deployments.
# CORS_ALLOWED_ORIGINS=https://studyshelf.example.com
